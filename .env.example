# Salin file ini menjadi .env.local untuk development di komputer lokal.
# Di Vercel, isi nilai yang sama lewat Project Settings -> Environment Variables.

# Connection string Postgres. Bisa dari Supabase (Project Settings -> Database
# -> Connection string -> URI, pakai mode "Transaction" / port 6543 untuk
# serverless), Neon, atau provider Postgres lain.
DATABASE_URL=postgresql://user:password@host:6543/dbname?sslmode=require

# Token Vercel Blob untuk unggah foto rekam medis (Vercel Dashboard -> Storage -> Blob -> .env.local tab).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# --- Mode Demo (opsional) ---
# Aktifkan untuk menampilkan tombol "Isi Email & Password Demo" di halaman
# login. Akun yang emailnya cocok dengan NEXT_PUBLIC_DEMO_EMAIL otomatis
# tidak bisa mengubah apa pun di halaman Pengaturan (kelola staf & backup/
# restore data) walau perannya Admin. Pastikan akun ini juga benar-benar ada
# di tabel staff (lihat baris "demo1" di schema.sql) dengan email & password
# yang SAMA PERSIS dengan nilai di sini. Nilai NEXT_PUBLIC_* ini terlihat oleh
# siapa saja yang membuka halaman login, jadi jangan pakai password staf asli.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@lareangon.local
NEXT_PUBLIC_DEMO_PASSWORD=demo123
